# Copy to `android/key.properties` (gitignored) before building a release.
# Generate the keystore with:
#   keytool -genkey -v -keystore ~/.android/kharchasplit-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias kharchasplit
#
# Then fill in:
storeFile=/absolute/path/to/kharchasplit-release.jks
storePassword=CHANGE_ME
keyAlias=kharchasplit
keyPassword=CHANGE_ME
