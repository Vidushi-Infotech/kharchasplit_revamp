<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules for backup + device-to-device transfer.
  Same exclusions as backup_rules.xml. Required because the legacy
  fullBackupContent attribute alone doesn't cover Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="file" path="hive/." />
        <exclude domain="file" path="cache/." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="file" path="hive/." />
        <exclude domain="file" path="cache/." />
    </device-transfer>
</data-extraction-rules>
