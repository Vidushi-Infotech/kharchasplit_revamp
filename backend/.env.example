# Server Configuration
# In production: NODE_ENV must be exactly 'production'.
NODE_ENV=production
PORT=3000
API_VERSION=v1

# Database Configuration
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=kharchasplit
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS — comma-separated allow-list. The server REFUSES TO START in
# production if this is empty or '*'. In dev, '*' or empty is permitted.
# Example: CORS_ORIGIN=https://app.kharchasplit.com,https://web.kharchasplit.com
CORS_ORIGIN=*

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Email (required for password reset OTP via SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@kharchasplit.com

# Logging
LOG_LEVEL=info

# In-App Update — version gating served by GET /api/v1/app-version
# LATEST_APP_VERSION        : latest released version (semantic, no build code)
# MIN_SUPPORTED_APP_VERSION : anything below this triggers a FORCE update
# FORCE_UPDATE_MESSAGE      : shown in the blocking dialog
# SOFT_UPDATE_MESSAGE       : shown in the dismissible dialog
# Change-then-redeploy is the rollout knob; no DB or code change needed.
LATEST_APP_VERSION=3.3.0
MIN_SUPPORTED_APP_VERSION=3.0.0
FORCE_UPDATE_MESSAGE=A critical update is required to keep using KharchaSplit.
SOFT_UPDATE_MESSAGE=A new version of KharchaSplit is available with improvements and fixes.

# WATI (WhatsApp Business API)
WATI_API_URL=https://live-mt-server.wati.io/427966
WATI_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Tn_g2R6N974TeNQQwYmhe_nH9fT-eFstZMZUPR3GGbI
WATI_TEMPLATE_NAME=kharchasplit_expense_notification

# ─── Email verification reminder job (optional; all have defaults) ───
# Daily nudge to active users whose email is still unverified.
# EMAIL_VERIFY_REMINDERS=false            # disable the job entirely
# EMAIL_VERIFY_REMINDER_HOUR=10           # hour of day (server local time) to run
# EMAIL_VERIFY_REMINDER_MIN_ACTIVITY=3    # activities in the last 7 days needed to qualify

# ─── Notification email outbox (optional) ───
# Notification emails are queued in email_outbox and sent right away;
# a worker on PM2 instance 0 retries failures every minute (5 attempts).
# EMAIL_OUTBOX_WORKER=false               # disable the retry worker

# ─── Automatic settle-up reminders (optional; all have defaults) ───
# Daily: reminds a debtor when a balance has been open AGE_DAYS, at most
# every INTERVAL_DAYS, MAX times per debt. Archived groups are skipped.
# AUTO_SETTLEMENT_REMINDERS=false         # disable the job
# AUTO_REMINDER_HOUR=11                   # hour of day (server local time)
# AUTO_REMINDER_AGE_DAYS=3
# AUTO_REMINDER_INTERVAL_DAYS=7
# AUTO_REMINDER_MAX=3
# AUTO_REMINDER_MIN_AMOUNT=10

# ─── Weekly summary email (opt-in per user in the app) ───
# WEEKLY_SUMMARY=false                    # disable the job
# WEEKLY_SUMMARY_WEEKDAY=1                # 0 = Sunday … 6 = Saturday
# WEEKLY_SUMMARY_HOUR=10

# ─── Feature flags (optional) ───
# Comma-separated; published to the app via GET /app-version → features.
# FEATURES=multiPayer,upiPay

# ─── Cross-process cache invalidation (PM2 cluster) ───
# Each worker keeps an in-memory cache; invalidations are broadcast to the
# other workers over Postgres LISTEN/NOTIFY (services/cacheBus.js). While the
# listener is down the cache is bypassed, never served stale.
# CACHE_BUS=false              # ONLY for a single-process deployment
# CACHE_REINVALIDATE_MS=1500   # second delete pass that catches commit races

# ── Production extras ────────────────────────────────────────────────
# Postgres over TLS (managed databases)
# DB_SSL=true
# Proxy hops in front of node (Cloudflare → LB → node = 2)
# TRUST_PROXY=1
# Store / install links used in invite emails
# APP_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.kharchasplit
# APP_APP_STORE_URL=https://apps.apple.com/app/id6754237285
# APP_INSTALL_URL=
# Force the update dialog for every version below LATEST (default true);
# false = only below MIN_SUPPORTED is forced, others get a soft prompt
# FORCE_UPDATE_ENABLED=true
# Server feature flags (see README "Feature flags")
# FEATURES=upiPay,settleAll,simplifyDebts
# Push notifications (Firebase service account JSON path)
# FIREBASE_SERVICE_ACCOUNT=
# Receipt photos, outside the web root and backed up
# RECEIPTS_DIR=/var/www/websites/kharchasplit/receipts
# Daily jobs; hours are India time (IST)
# RECURRING_EXPENSES=false   # disable recurring expenses
# RECURRING_HOUR=6
# BILL_REMINDERS=false       # disable bill reminders
# BILL_REMINDER_HOUR=9
