{
  "info": {
    "_postman_id": "kharchasplit-api-v1-used",
    "name": "KharchaSplit API v1 (App-used endpoints)",
    "description": "Postman collection containing only the endpoints actually invoked by the KharchaSplit Flutter app. Generated by cross-referencing backend/src/routes/* with frontend/lib/data/* repositories, modules/*/state/* providers, and core/services/push_service.dart.\n\n## Setup\n1. The `baseUrl` variable is pre-set to production: `https://api.kharchasplit.com/api/v1`. Override it in the Variables tab if you need to point at staging or local (e.g. `http://localhost:3000/api/v1`).\n2. Run `POST /auth/verify-otp` (or `/auth/simple-login` in dev) to obtain tokens — the test script auto-saves `accessToken`, `refreshToken`, and `userId` into the collection variables.\n3. All non-public endpoints use the collection-level Bearer auth, which reads `{{accessToken}}` automatically.\n\n## Conventions\n- Response envelope: `{ success, data, message?, pagination? }`.\n- Currency codes are ISO-4217 (`INR`, `USD`). Amounts are JSON numbers.\n- IDs are UUIDs.\n- Bodies up to 10 MB (for base64 receipt photos).\n- Rate limits: 200/min global IP, 5 OTP per phone / 15 min, 60 expense creates per user / min, reminder push max once per 6 h per (caller, target, group).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.kharchasplit.com/api/v1",
      "type": "string"
    },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "groupId", "value": "", "type": "string" },
    { "key": "expenseId", "value": "", "type": "string" },
    { "key": "settlementId", "value": "", "type": "string" },
    { "key": "phoneNumber", "value": "+919876543210", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/../health",
              "host": ["{{baseUrl}}"],
              "path": ["..", "health"]
            },
            "description": "Public. Server status + DB pool + cache metrics. Lives at /health, not under /api/v1."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"name\": \"Asha\",\n  \"email\": \"asha@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Create a user + trigger OTP. Used by data/auth/auth_repository.dart -> AuthRepository.register(). Rate-limited (5/phone/15min)."
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            },
            "description": "Public. Twilio Verify SMS. User does NOT need to exist beforehand. Rate-limited (5/phone/15min)."
          }
        },
        {
          "name": "Verify OTP & login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.success && res.data) {",
                  "  if (res.data.accessToken) pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  if (res.data.refreshToken) pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "  if (res.data.user && res.data.user.id) pm.collectionVariables.set('userId', res.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"otp\": \"123456\",\n  \"device\": {\n    \"name\": \"Pixel 7\",\n    \"platform\": \"android\",\n    \"osVersion\": \"14\",\n    \"appVersion\": \"3.0.0+15\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            },
            "description": "Verifies the OTP, returns access + refresh tokens. Auto-creates a user row if the phone is new. The test script auto-saves tokens + userId into collection variables."
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.success && res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Called automatically by the Dio interceptor (core/network/api_client.dart) on 401."
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Simple login (dev only)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/simple-login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "simple-login"]
            },
            "description": "App gates this behind kReleaseMode — used in dev/debug builds only. Returns 404 if user does not exist."
          }
        },
        {
          "name": "List sessions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Current-Refresh-Token", "value": "{{refreshToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sessions"]
            },
            "description": "Active Sessions screen. Pass X-Current-Refresh-Token to mark which row is this device."
          }
        },
        {
          "name": "Revoke single session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sessions", ":id"],
              "variable": [{ "key": "id", "value": "<session-id>" }]
            }
          }
        },
        {
          "name": "Revoke all sessions (keep current)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keepRefreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sessions"]
            }
          }
        }
      ]
    },
